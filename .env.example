# Documentation template only. This app reads Cloudflare Worker bindings.
# Copying this to .env does not implement a company-server runtime adapter.
# See docs/CONFIGURATION.example.txt and docs/DEVELOPER-HANDOFF.md.
GMAIL_RELAY_URL=
GMAIL_RELAY_SECRET=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Runtime secrets, at least 32 characters each; not build variables.
BOOTSTRAP_SECRET=
JOBS_SECRET=
# HTTPS origin used by scheduled reminder hooks if later enabled.
APP_ORIGIN=
# Optional build variable: UUID for a new company/demo Cloudflare D1 database.
SFTE_D1_DATABASE_ID=
